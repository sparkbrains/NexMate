APP_ENV=local
GROQ_API_KEY=
GENERATION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
#GENERATION_MODEL=llama-3.3-70b-versatile
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

FAST_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
THREAD_SUMMARY_TRIGGER_TOKENS=1800
THREAD_SUMMARY_KEEP_LAST_TURNS=4
THREAD_SUMMARY_MAX_WORDS=120
APP_REFERER=http://localhost:8000
DETECT_LOOPS_CROSS_THREAD_PROMPT_LIMIT=12
DETECT_LOOPS_MAX_PROMPT_TOKENS=2200
DIGEST_TOKEN_TARGET=400
APP_TITLE=nextmate

# Docker Compose Postgres for NextMate.
DATABASE_URL=postgresql://nextmate_user:nextmate_password@postgres:5432/nextmate

# Key for app-layer encryption of sensitive DB columns (apps/crypto.py) --
# journal content, chat messages, dob/motivation. Required. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this OUT of source control -- losing it makes every encrypted row
# permanently unreadable, and it must be the same value across every process
# reading/writing the DB (all app instances, workers, migration scripts).
DB_ENCRYPTION_KEY=

MEMORY_WINDOW=20
STREAM_CHUNK_SIZE=1
STREAM_DELAY_SECONDS=0.05
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


SMTP_HOST=mail.smtp2go.com
SMTP_PORT=2525
SMTP_USE_TLS=True
DEFAULT_EMAIL_FROM='Sparkbrains Pvt. Ltd. <no-reply@sparkbrains.ai>'
SMTP_USER=
SMTP_PASSWORD=
SEED_DUMMY_USERS=true
DUMMY_USERS=demo@nextmate.local:demo123,qa@nextmate.local:demo123
